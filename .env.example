
# Development environment
RAILS_ENV=development

# Development and test database connections
# Replace change_me with your own local MySQL password.
DATABASE_URL=mysql2://dev:change_me@db:3306/reimplementation_development
TEST_DATABASE_URL=mysql2://dev:change_me@db:3306/reimplementation_test

# Cache configuration
CACHE_STORE=change_me

# Local MariaDB container credentials (development only)
MARIADB_USER=dev
MARIADB_PASSWORD=change_me
MARIADB_ROOT_PASSWORD=change_me

# MARIADB_DATABASE must match the database name specified in DATABASE_URL.
# If you change the development database name, update both values.
MARIADB_DATABASE=reimplementation_development

# Production database
# Production uses an external database server.
# Supply PROD_DATABASE_URL securely in the production environment.
# Do not commit real production credentials.
# PROD_DATABASE_URL=mysql2://user:password@external-host:3306/database_name

# Backend image published to GitHub Container Registry
BACKEND_IMAGE=ghcr.io/expertiza/reimplementation-back-end
BACKEND_IMAGE_TAG=latest
