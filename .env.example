
# Development environment
RAILS_ENV=development

# Development and test database connections
# Replace change_me with your own local MySQL password.
DATABASE_URL=mysql2://dev:change_me@db:3306/reimplementation
TEST_DATABASE_URL=mysql2://dev:change_me@db:3306/reimplementation_test

# Cache configuration
CACHE_STORE=change_me

# Local MySQL container credentials (development only)
MYSQL_USER=dev
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=reimplementation

# Production database
# Production uses an external database server.
# Supply PROD_DATABASE_URL securely in the production environment.
# Do not commit real production credentials.
# PROD_DATABASE_URL=mysql2://user:password@external-host:3306/database_name
